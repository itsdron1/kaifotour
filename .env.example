# Отзывы из профиля KAIFO в Google (необязательно).
# Пока переменных нет, раздел «Отзывы» показывает только отзывы из data/reviews.ts.
# Значения класть в .env.local локально и в Environment Variables на Vercel; в репозиторий они не попадают.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=

# Google Tag Manager (необязательно): ID контейнера вида GTM-XXXXXXX с tagmanager.google.com.
# Пока переменной нет, GTM, баннер cookies и события не загружаются. Настройка — docs/analytics.md.
NEXT_PUBLIC_GTM_ID=
